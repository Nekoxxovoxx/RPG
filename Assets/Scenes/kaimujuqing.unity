  - text: "\u6B7B\u4EA1\u4E0D\u80FD\u6536\u7559\u4ED6\u4EEC\u3002\n\u5B89\u7720\u4E5F\u4E0D\u518D\u5C5E\u4E8E\u4ED6\u4EEC\u3002"
  - text: "\u53EA\u8981\u65E7\u706B\u4ECD\u9700\u67F4\u85AA\uFF0C\n\u4F20\u706B\u8005\u4FBF\u4F1A\u4E00\u6B21\u6B21\u5F52\u6765\u3002"
  - text: "\u76F4\u5230\u6210\u4E3A\u65B0\u7684\u706B\uFF0C\n\u6216\u5F7B\u5E95\u5316\u4E3A\u7070\u70EC\u3002"
  playOnStart: 1
  hideWhenFinished: 1
  useTypewriter: 1
  charactersPerSecond: 20
  inputDelay: 0.12

--- !u!114 &1879078889
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1879078887}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7a82fc73a96e4e10a77f61d4b2a648e5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  pages:
  - backgroundRoot: {fileID: 1279491576}
    dialogueBoxRoot: {fileID: 1658666414}
    monologueText: {fileID: 600945035}
    lines:
    - text: "\u5728\u7070\u7EAA\u4E4B\u524D\uFF0C\u4E16\u754C\u5E76\u975E\u5982\u6B64\u6C89\u5BC2\u3002"
    - text: "\u90A3\u65F6\uFF0C\u65E7\u706B\u81EA\u5927\u5730\u6DF1\u5904\u5347\u8D77\uFF0C\u7167\u4EAE\u7FA4\u5C71\u3001\u57CE\u90A6\u4E0E\u4EBA\u7684\u59D3\u540D\u3002"
    - text: "\u706B\u8D50\u4E88\u79E9\u5E8F\uFF0C\u4E5F\u8D50\u4E88\u738B\u6743\u3002"
    - text: "\u800C\u6D1B\u708E\u5FB7\uFF0C\u4FBF\u5728\u90A3\u706B\u5149\u4E2D\u8BDE\u751F\u3002"
  - backgroundRoot: {fileID: 770451871}
    dialogueBoxRoot: {fileID: 327925625}
    monologueText: {fileID: 985983272}
    lines:
    - text: "\u4E8E\u662F\uFF0C\u738B\u57CE\u62D4\u5730\u800C\u8D77\u3002"
    - text: "\u9AD8\u5899\u3001\u5C16\u5854\u3001\u5723\u5802\u4E0E\u957F\u6865\uFF0C\u5728\u706B\u5149\u4E2D\u8FDE\u6210\u4E0D\u5760\u7684\u56FD\u5EA6\u3002"
    - text: "\u6D77\u6F6E\u53E9\u51FB\u57CE\u57FA\uFF0C\u7FA4\u6C11\u4EF0\u671B\u738B\u5EA7\u3002"
    - text: "\u90A3\u662F\u6D1B\u708E\u5FB7\u6700\u8F89\u714C\u7684\u5E74\u4EE3\uFF0C\u4E5F\u662F\u65E7\u706B\u6700\u63A5\u8FD1\u6C38\u6052\u7684\u65F6\u523B\u3002"
  - backgroundRoot: {fileID: 890463329}
    dialogueBoxRoot: {fileID: 1892727853}
    monologueText: {fileID: 811055941}
    lines:
    - text: "\u4E8C\u5341\u4E00\u4F4D\u738B\uFF0C\u5171\u6267\u8FD9\u7247\u571F\u5730\u7684\u547D\u8109\u3002"
    - text: "\u6709\u4EBA\u7EDF\u5FA1\u950B\u5203\uFF0C\u6709\u4EBA\u6267\u638C\u65E5\u8F6E\uFF0C\u6709\u4EBA\u5B88\u671B\u949F\u5854\u3001\u9675\u5893\u3001\u6D77\u96FE\u4E0E\u6697\u5F71\u3002"
    - text: "\u4ED6\u4EEC\u662F\u6D1B\u708E\u5FB7\u7684\u51A0\u5195\uFF0C\u662F\u706B\u4E2D\u7ACB\u8A93\u4E4B\u4EBA\u3002"
    - text: "\u4EBA\u4EEC\u66FE\u76F8\u4FE1\uFF0C\u53EA\u8981\u8BF8\u738B\u5C1A\u5728\uFF0C\u4E16\u754C\u4FBF\u4E0D\u4F1A\u503E\u8986\u3002"
  - backgroundRoot: {fileID: 1843758360}
    dialogueBoxRoot: {fileID: 1155860577}
    monologueText: {fileID: 1111138871}
    lines:
    - text: "\u53EF\u7EC8\u672B\uFF0C\u5E76\u975E\u81EA\u6D1B\u708E\u5FB7\u5185\u90E8\u751F\u51FA\u3002"
    - text: "\u7070\u5E55\u964D\u4E34\u4E86\u3002"
    - text: "\u90A3\u4E0D\u662F\u96FE\uFF0C\u4E0D\u662F\u591C\uFF0C\u800C\u662F\u53E6\u4E00\u4E2A\u4E16\u754C\u7684\u8FB9\u754C\u3002"
    - text: "\u5728\u7070\u5E55\u4E4B\u540E\uFF0C\u5F02\u754C\u795E\u683C\u7741\u5F00\u4E86\u773C\u3002"
    - text: "\u5B83\u4EEC\u65E0\u987B\u5F81\u670D\uFF0C\u53EA\u9700\u6CE8\u89C6\uFF0C\u5C71\u5DDD\u4FBF\u4F1A\u8150\u574F\uFF0C\u57CE\u90A6\u4FBF\u4F1A\u5D29\u88C2\uFF0C\u4F17\u751F\u4FBF\u4F1A\u5FD8\u8BB0\u81EA\u5DF1\u4ECD\u662F\u4EBA\u3002"
  - backgroundRoot: {fileID: 839358101}
    dialogueBoxRoot: {fileID: 1987495474}
    monologueText: {fileID: 325903685}
    lines:
    - text: "\u4E8E\u662F\uFF0C\u8BF8\u738B\u8D77\u5175\uFF0C\u4E0E\u5E55\u5916\u4E4B\u654C\u93D6\u6218\u3002"
    - text: "\u53EF\u5F02\u754C\u4E4B\u7269\u65E0\u6CD5\u88AB\u771F\u6B63\u6740\u6B7B\uFF0C\u5B83\u4EEC\u5728\u7070\u5E55\u4E2D\u6E83\u6563\uFF0C\u53C8\u5728\u53E6\u4E00\u5904\u5F52\u6765\u3002"
    - text: "\u767D\u949F\u6C89\u5BC2\uFF0C\u94C1\u5893\u5C3D\u6BC1\uFF0C\u96FE\u6D77\u65E0\u5F52\uFF0C\u94DC\u72EE\u4F0F\u5C38\u53E4\u6218\u573A\u3002"
    - text: "\u4E5F\u6709\u738B\u88AB\u6050\u60E7\u541E\u6CA1\uFF0C\u6216\u8EB2\u5165\u9AD8\u5899\uFF0C\u6216\u6C89\u5165\u957F\u68A6\uFF0C\u6216\u62B9\u53BB\u59D3\u540D\uFF0C\u53EA\u6C42\u4E0D\u88AB\u7070\u5E55\u5BFB\u5230\u3002"
    - text: "\u4ECE\u90A3\u4E00\u65E5\u8D77\uFF0C\u6D1B\u708E\u5FB7\u4E0D\u518D\u5B8C\u6574\u3002"
  - backgroundRoot: {fileID: 1850210799}
    dialogueBoxRoot: {fileID: 1112807988}
    monologueText: {fileID: 622807318}
    lines:
    - text: "\u5F53\u7070\u5E55\u541E\u566C\u52A0\u5267\uFF0C\u516D\u4F4D\u738B\u4F5C\u51FA\u4E86\u6700\u540E\u7684\u6289\u62E9\u3002"
    - text: "\u7089\u5FC3\u738B\u3001\u75BE\u884C\u738B\u3001\u85AA\u5251\u738B\u3001\u9006\u950B\u738B\u3001\u65E5\u8F6E\u738B\u3001\u533F\u5F71\u738B\u2026\u2026"
    - text: "\u4ED6\u4EEC\u820D\u5F03\u8089\u8EAB\uFF0C\u71C3\u5C3D\u738B\u6743\uFF0C\u5C06\u81EA\u8EAB\u6295\u5165\u65E7\u706B\u3002"
    - text: "\u81EA\u6B64\uFF0C\u4ED6\u4EEC\u4E0D\u518D\u53EA\u662F\u738B\u3002"
    - text: "\u65E7\u706B\u4EE5\u65B0\u7684\u540D\u5B57\u94ED\u8BB0\u4ED6\u4EEC\u2014\u2014\n"
    - text: "\u71C3\u85AA\u70EC\u738B\u3001\u9010\u7070\u70EC\u738B\u3001\u65E7\u5251\u70EC\u738B\u3001\u9006\u950B\u70EC\u738B\u3001\u5760\u65E5\u70EC\u738B\u3001\u533F\u5F71\u70EC\u738B\u3002"
  - backgroundRoot: {fileID: 1079508325}
    dialogueBoxRoot: {fileID: 1733917893}
    monologueText: {fileID: 2062793722}
    lines:
    - text: "\u516D\u738B\u4EE5\u81EA\u8EAB\u4E3A\u6954\uFF0C\u9489\u4F4F\u4E86\u5C06\u8981\u5D29\u6BC1\u7684\u8FB9\u754C\u3002"
    - text: "\u4ED6\u4EEC\u8BBE\u4E0B\u4E86\u65E7\u706B\u5F8B\u3002"
    - text: "\u90A3\u4E0D\u662F\u6069\u8D50\uFF0C\u800C\u662F\u4E00\u9053\u71C3\u70E7\u4E16\u754C\u7684\u9501\u94FE\u3002"
    - text: "\u5B83\u538B\u4F4F\u7070\u5E55\uFF0C\u5C01\u7F1A\u754C\u8680\uFF0C\u8BA9\u5F02\u754C\u795E\u683C\u6C89\u5165\u6F2B\u957F\u800C\u4E0D\u5B89\u7684\u6C89\u7761\u3002"
    - text: "\u6D1B\u708E\u5FB7\u56E0\u6B64\u672A\u66FE\u706D\u4EA1\u3002\n\u5374\u4E5F\u4ECE\u6B64\uFF0C\u518D\u65E0\u6CD5\u6446\u8131\u706B\u7684\u4EE3\u4EF7\u3002"
  - backgroundRoot: {fileID: 1931657706}
    dialogueBoxRoot: {fileID: 1372511471}
    monologueText: {fileID: 1095470990}
    lines:
    - text: "\u800C\u65E7\u706B\u5F8B\u7559\u4E0B\u7684\uFF0C\u5E76\u4E0D\u53EA\u6709\u5C01\u5370\u3002"
    - text: "\u5B83\u4E5F\u5C06\u4E00\u7C7B\u4EBA\uFF0C\u6C38\u8FDC\u7CFB\u5728\u6B7B\u4EA1\u4E4B\u5916\u3002"
    - text: "\u4ED6\u4EEC\u88AB\u79F0\u4F5C\u4F20\u706B\u8005\u3002"
    - text: "\u6BCF\u5F53\u4ED6\u4EEC\u7184\u706D\uFF0C\u65E7\u706B\u5F8B\u4FBF\u4F1A\u53EC\u56DE\u6B8B\u706B\uFF0C\u4F7F\u5176\u4E8E\u5F52\u706B\u4E4B\u5730\u518D\u5EA6\u82CF\u9192\u3002"
    - text: "\u6B7B\u800C\u590D\u751F\uFF0C\u4E0D\u662F\u795D\u798F\u3002"
    - text: "\u90A3\u53EA\u662F\u4E16\u754C\u5C1A\u672A\u5141\u8BB8\u4ED6\u4EEC\u79BB\u53BB\u3002"
    - text: "\u5982\u4ECA\uFF0C\u706B\u5C06\u5C3D\uFF0C\u7070\u5E55\u5374\u5C1A\u672A\u6563\u53BB\u3002"
    - text: "\u800C\u4F60\uFF0C\u6B63\u662F\u88AB\u65E7\u706B\u518D\u4E00\u6B21\u5524\u56DE\u4E4B\u4EBA\u3002"

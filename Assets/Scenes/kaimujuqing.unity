--- !u!114 &1843758364
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1843758360}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1e2cda7f5e5145e4b99d4fd3f8fb5f0d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueBoxRoot: {fileID: 1155860577}
  monologueText: {fileID: 1111138871}
  monologueLines:
  - text: "\u4E3A\u4E86\u5EF6\u7EED\u65E7\u706B\uFF0C\u8BF8\u738B\u518D\u6B21\u732E\u4E0A\u81EA\u8EAB\u3002"
  - text: "\u738B\u51A0\u88AB\u70E7\u88C2\uFF0C\u8840\u8089\u5316\u4F5C\u7126\u9ED1\u7684\u5723\u7070\uFF0C\n\u7075\u9B42\u5219\u6C89\u5165\u706B\u7684\u6700\u6DF1\u5904\u3002"
  - text: "\u81EA\u90A3\u4EE5\u540E\uFF0C\u4E16\u4E0A\u518D\u65E0\u8BF8\u738B\u3002\n\u53EA\u5269\u70EC\u738B\u3002"
  - text: "\u4ED6\u4EEC\u6C89\u7720\u4E8E\u738B\u5EA7\u4E4B\u4E0B\uFF0C\n\u6000\u62B1\u6B8B\u5B58\u7684\u6743\u67C4\uFF0C\u7B49\u5F85\u4E0B\u4E00\u4E2A\u732E\u70EC\u8005\u3002"
  playOnStart: 1
  hideWhenFinished: 1
  useTypewriter: 1
  charactersPerSecond: 20
  inputDelay: 0.12

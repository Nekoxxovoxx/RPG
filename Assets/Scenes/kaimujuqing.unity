  monologueText: {fileID: 811055941}
  monologueLines:
  - text: "\u7136\u800C\uFF0C\u7070\u5E55\u81EA\u5929\u5916\u5782\u843D\u3002"
  - text: "\u5B83\u4E0D\u5E26\u96F7\u58F0\uFF0C\u4E0D\u964D\u795E\u7F5A\uFF0C\n\u53EA\u662F\u4E00\u5BF8\u4E00\u5BF8\u906E\u4F4F\u706B\u5149\u3002"
  - text: "\u6D1B\u708E\u5FB7\u7684\u949F\u58F0\u5F00\u59CB\u7834\u788E\uFF0C\n\u9AD8\u5854\u5760\u5165\u7070\u4E91\uFF0C\u5723\u57CE\u71C3\u5C3D\u4F59\u6E29\u3002"
  - text: "\u65E7\u706B\u5F00\u59CB\u8870\u8D25\uFF0C\n\u6D1B\u708E\u5FB7\u4E5F\u968F\u4E4B\u5760\u5165\u6F2B\u957F\u7684\u7070\u7EAA\u3002"
  playOnStart: 1
  hideWhenFinished: 1
  useTypewriter: 1
  charactersPerSecond: 20
  inputDelay: 0.12

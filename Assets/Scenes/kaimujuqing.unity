  monologueLines:
  - text: "\u8BF8\u738B\u66FE\u56F4\u5750\u4E8E\u65E7\u706B\u4E4B\u524D\u3002"
  - text: "\u4ED6\u4EEC\u4EE5\u51A0\u5195\u7ACB\u8A93\uFF0C\u4EE5\u8840\u8089\u627F\u85AA\uFF0C\n\u5C06\u81EA\u5DF1\u7684\u6743\u67C4\u732E\u7ED9\u4E0D\u706D\u4E4B\u7130\u3002"
  - text: "\u5251\u3001\u65E5\u3001\u5F71\u3001\u7070\u3001\u9006\u950B\u4E0E\u71C3\u85AA\uFF0C\n\u7686\u5728\u90A3\u4E00\u591C\u88AB\u523B\u5165\u738B\u5EA7\u3002"
  - text: "\u4E16\u4EBA\u79F0\u4ED6\u4EEC\u4E3A\u738B\u3002\n\u800C\u706B\uFF0C\u79F0\u4ED6\u4EEC\u4E3A\u67F4\u85AA\u3002"

--- !u!114 &677485116
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 677485112}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9f4c7c5d2f5c4c44ab0b97c4bbf40216, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  pages:
  - backgroundRoot: {fileID: 677485112}
    dialogueBoxRoot: {fileID: 826087980}
    dialogueText: {fileID: 1032191487}
    nameText: {fileID: 1014070267}
    lines:
    - speaker: 0
      text: "\u6B64\u5904\u5F80\u524D\uFF0C\u4FBF\u4E0D\u518D\u662F\u65E7\u72EE\u6D1E\u9053\u3002"
    - speaker: 0
      text: "\u8FD9\u7247\u66FE\u7ECF\u7684\u6218\u573A\u7EC8\u4E8E\u4E5F\u5982\u540C\u6D1B\u708E\u5FB7\u5404\u5730\u4E00\u6837\u574D\u584C\u3002"
    - speaker: 0
      text: "\u8D64\u9AD3\u5B88\u536B\u5F52\u4E8E\u6C89\u5BC2\u3002\n"
    - speaker: 0
      text: "\u5B83\u5728\u8FD9\u91CC\u5B88\u4E86\u592A\u4E45\uFF0C\u4E45\u5230\u5FD8\u8BB0\u4E00\u5207\uFF0C\u751A\u81F3\u662F\u5B88\u62A4\u8FD9\u91CC\u7684\u539F\u56E0\u3002"
    - speaker: 1
      text: "\u90A3\u4E1C\u897F\u2026\u2026\u66FE\u7ECF\u4E5F\u662F\u4EBA\u5417\uFF1F"
    - speaker: 0
      text: "\u4E5F\u8BB8\u662F\u4EBA\u3002\n\u4E5F\u8BB8\uFF0C\u662F\u8BB8\u591A\u4EBA\u7684\u6B8B\u9AB8\u3002"
    - speaker: 0
      text: "\u8840\u8089\u3001\u4F59\u706B\u3001\u94C1\u7247\uFF0C\u8FD8\u6709\u6700\u540E\u7684\u547D\u4EE4\u3002\n"
    - speaker: 0
      text: "\u7070\u5E55\u5C06\u5B83\u4EEC\u63C9\u5728\u4E00\u8D77\uFF0C\u6700\u7EC8\u4FBF\u6210\u4E86\u60A8\u6240\u89C1\u4E4B\u7269\u3002"
    - speaker: 1
      text: "\u5B88\u4F4F\u8FD9\u91CC\u2026\u2026\n\u53EF\u8FD9\u91CC\u5DF2\u7ECF\u4EC0\u4E48\u90FD\u6CA1\u6709\u4E86\u3002"
    - speaker: 0
      text: "\u662F\u7684\uFF0C\u4F20\u706B\u8005\u5927\u4EBA\u3002\n\u8FD9\u6B63\u662F\u7070\u5E55\u6700\u6B8B\u5FCD\u4E4B\u5904\u3002"
    - speaker: 0
      text: "\u5B83\u4E0D\u53EA\u662F\u4F1A\u593A\u8D70\u751F\u547D\u3002\n\u8FD8\u4F1A\u626D\u66F2\u804C\u8D23\u4E0E\u8A93\u8A00\u3002"
    - speaker: 0
      text: "\u6700\u540E\u53D8\u4E3A\u6267\u5FF5\u3002"
    - speaker: 1
      text: "\u6211\u6740\u4E86\u5B83\u2026\u2026\u662F\u5426\u8BA9\u5B83\u89E3\u8131\u4E86\uFF1F"
    - speaker: 0
      text: "\u60A8\u8BA9\u65E7\u65E5\u7684\u547D\u4EE4\u505C\u6B62\u4E86\u56DE\u54CD\u3002"
    - speaker: 0
      text: "\u5BF9\u90A3\u5B88\u536B\u800C\u8A00\uFF0C\u6B7B\u4EA1\u7EC8\u4E8E\u8FFD\u4E0A\u4E86\u5B83\u3002"
    - speaker: 0
      text: "\u8BF7\u770B\u524D\u65B9\uFF0C\u4F20\u706B\u8005\u5927\u4EBA\u3002"
    - speaker: 0
      text: "\u7B2C\u4E00\u52AB\u7AE0\u7684\u7070\u5E55\uFF0C\u5DF2\u7ECF\u88C2\u5F00\u3002"
    - speaker: 1
      text: "\u8FD9\u5C31\u662F\u6D1B\u708E\u5FB7\u5982\u4ECA\u7684\u6837\u5B50\uFF1F"
    - speaker: 0
      text: "\u53EA\u662F\u5176\u4E2D\u4E00\u89D2\u3002"
    - speaker: 0
      text: "\u738B\u57CE\u503E\u584C\uFF0C\u8BF8\u738B\u6C89\u7720\uFF0C\u65E7\u706B\u5C06\u7184\u3002\n\u800C\u7070\u5E55\uFF0C\u4ECD\u5728\u5411\u5185\u541E\u98DF\u8FD9\u7247\u571F\u5730\u3002"
    - speaker: 1
      text: "\u6240\u4EE5\u6211\u8FD8\u8981\u7EE7\u7EED\u524D\u8FDB\u3002"
    - speaker: 0
      text: "\u82E5\u60A8\u4ECD\u613F\u627F\u706B\uFF0C\u4FBF\u5FC5\u987B\u7EE7\u7EED\u3002"
    - speaker: 0
      text: "\u524D\u65B9\u4F1A\u6709\u66F4\u591A\u6B8B\u54CD\uFF0C\u66F4\u591A\u65E7\u738B\u7684\u75D5\u8FF9\uFF0C\n\u4E5F\u4F1A\u6709\u66F4\u591A\u4E0D\u613F\u5B89\u606F\u7684\u4E1C\u897F\uFF0C\u4EE5\u53CA\u65E0\u5C3D\u7684\u7070\u5E55\u3002"
    - speaker: 1
      text: "\u6211\u8FD8\u80FD\u56DE\u6765\u5417\uFF1F"
    - speaker: 0
      text: "\u53EA\u8981\u60A8\u7684\u4F59\u70EC\u5C1A\u672A\u51B7\u5374\uFF0C\n\u5F52\u706B\u4E4B\u5730\u4FBF\u4F1A\u8BB0\u5F97\u60A8\u7684\u5F52\u9014\u3002"
    - speaker: 0
      text: "\u800C\u6211\uFF0C\u4E5F\u4F1A\u7EE7\u7EED\u5728\u706B\u65C1\u7B49\u5019\u3002"
    - speaker: 1
      text: "\u8BDD\u8BF4...\u4F60\u6709\u540D\u5B57\u5417\uFF1F"
    - speaker: 0
      text: "\u4F8D\u706B\u5DEB\u5973\u4ECE\u51FA\u751F\u7684\u90A3\u4E00\u523B\u4FBF\u53EA\u6709\u4F7F\u547D\u3002"
    - speaker: 0
      text: "\u540D\u5B57\u5BF9\u6211\u4EEC\u6765\u8BF4\u5E76\u4E0D\u91CD\u8981\u3002"
    - speaker: 1
      text: "\u53EF\u6211\u89C9\u5F97\uFF0C\u540D\u5B57\u5F88\u91CD\u8981\u3002"
    - speaker: 1
      text: "\u6211\u5DF2\u7ECF\u5FD8\u4E86\u81EA\u5DF1\u7684\u540D\u5B57\u3002\n\u4E5F\u5FD8\u4E86\u81EA\u5DF1\u4ECE\u54EA\u91CC\u6765\u3002"
    - speaker: 1
      text: "\u6240\u4EE5\u6211\u77E5\u9053\uFF0C\n\u6CA1\u6709\u540D\u5B57\u662F\u4EC0\u4E48\u611F\u89C9\u3002"
    - speaker: 1
      text: "\u6CA1\u6709\u4EBA\u547C\u5524\u7684\u5B64\u72EC......"
    - speaker: 0
      text: "\u60A8\u7684\u540D\u5B57\u5E76\u975E\u6D88\u5931\u3002\n\u53EA\u662F\u5728\u5F52\u706B\u4E2D\u9057\u5FD8\u4E86\u3002"
    - speaker: 0
      text: "\u7B49\u60A8\u7EE7\u7EED\u524D\u884C\uFF0C\n\u4E5F\u8BB8\u4F1A\u5728\u67D0\u5904\u6B8B\u54CD\u4E2D\u5C06\u5B83\u627E\u56DE\u3002"
    - speaker: 1
      text: "\u90A3\u5728\u6211\u627E\u56DE\u81EA\u5DF1\u7684\u540D\u5B57\u4E4B\u524D\uFF0C\n\u6211\u80FD\u5148\u7ED9\u4F60\u4E00\u4E2A\u540D\u5B57\u5417\uFF1F"
    - speaker: 0
      text: "\u7ED9\u6211\u2026\u2026\u540D\u5B57\uFF1F"
    - speaker: 1
      text: "\u55EF\u3002"
    - speaker: 1
      text: "\u4F60\u4E00\u76F4\u5B88\u5728\u706B\u65C1\u3002\n\u53EF\u4F60\u4E0D\u50CF\u706B\u90A3\u6837\u707C\u4EBA\u3002"
    - speaker: 1
      text: "\u66F4\u50CF\u662F\u7070\u70EC\u91CC\u6620\u51FA\u7684\u4E00\u70B9\u5149\u3002\n\u8106\u5F31\uFF0C\u5374\u6CA1\u6709\u7184\u706D\u3002"
    - speaker: 1
      text: "\u5C31\u53EB\u2026\u2026\u70EC\u7483\uFF0C\u600E\u4E48\u6837\uFF1F"
    - speaker: 0
      text: "\u70EC\u7483\u2026\u2026"
    - speaker: 0
      text: "\u7070\u70EC\u4E4B\u4E2D\u7684\u7409\u7483\u4E4B\u5149\u5417\uFF1F"
    - speaker: 1
      text: "\u5DEE\u4E0D\u591A\u5427\u3002\n\u6211\u4E0D\u592A\u4F1A\u8D77\u540D\u5B57\u3002"
    - speaker: 0
      text: "\u4E0D\uFF0C\u4F20\u706B\u8005\u5927\u4EBA\u3002"
    - speaker: 0
      text: "\u8FD9\u662F\u4E00\u4E2A\u5F88\u6E29\u67D4\u7684\u540D\u5B57\u3002"
    - speaker: 1
      text: "\u4F60\u559C\u6B22\uFF1F"
    - speaker: 0
      text: "\u82E5\u8FD9\u662F\u60A8\u8D50\u4E88\u6211\u7684\u540D\u5B57\uFF0C\n\u6211\u613F\u610F\u6536\u4E0B\u3002"
    - speaker: 0
      text: "\u4ECE\u4ECA\u4EE5\u540E\uFF0C\n\u6211\u4FBF\u662F\u70EC\u7483\u3002"
    - speaker: 1
      text: "\u90A3\u6211\u4EE5\u540E\u5C31\u53EB\u4F60\u70EC\u7483\u4E86\u3002"
    - speaker: 0
      text: "\u662F\uFF0C\u4F20\u706B\u8005\u5927\u4EBA\u3002"
    - speaker: 0
      text: "\u800C\u5728\u60A8\u627E\u56DE\u81EA\u5DF1\u7684\u540D\u5B57\u4E4B\u524D\uFF0C\n\u6211\u4ECD\u4F1A\u5982\u6B64\u79F0\u547C\u60A8\u3002"
    - speaker: 1
      text: "\u7B49\u6211\u627E\u56DE\u540D\u5B57\u7684\u65F6\u5019\u2026\u2026"
    - speaker: 0
      text: "\u6211\u4F1A\u8BB0\u4F4F\u5B83\u3002"
    - speaker: 0
      text: "\u4E5F\u4F1A\u5728\u5F52\u706B\u4E4B\u5730\uFF0C\n\u7B2C\u4E00\u6B21\u4EE5\u60A8\u7684\u540D\u5B57\u8FCE\u63A5\u60A8\u5F52\u6765\u3002"
    - speaker: 1
      text: "\u90A3\u5C31\u8BF4\u597D\u4E86\u3002"

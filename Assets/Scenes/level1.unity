    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: returnFireCompleteMessage
      value: "\u613F\u60A8\u7684\u4F59\u70EC\u4E0D\u706D\uFF0C\u4F20\u706B\u8005\u5927\u4EBA\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.size
      value: 12
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[0].text
      value: "\u4F20\u706B\u8005\u5927\u4EBA\uFF0C\u60A8\u5DF2\u62B5\u8FBE\u6D1E\u7A74\u6DF1\u5904\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[1].text
      value: "\u6B64\u5904\u7684\u706B\u5F88\u5FAE\u5F31\uFF0C\n\u4F46\u4ECD\u8DB3\u4EE5\u4E3A\u60A8\u8BB0\u4E0B\u5F52\u9014\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[2].text
      value: "\u8BF7\u5728\u6B64\u5F52\u706B\u5427\u3002\n\u524D\u65B9\u7684\u654C\u4EBA\uFF0C\u5E76\u975E\u5BFB\u5E38\u71C3\u9AB8\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[3].text
      value: "\u5B83\u5B88\u5728\u65E7\u4E16\u9057\u7269\u4E4B\u524D\uFF0C\u50CF\u662F\u4ECD\u5728\u5C65\u884C\u65E9\u5DF2\u8150\u673D\u7684\u547D\u4EE4\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[4].text
      value: "\u5728\u60A8\u8E0F\u5165\u6218\u573A\u4E4B\u524D\uFF0C\n\u8BF7\u770B\u5411\u8EAB\u540E\u7684\u5B9D\u7BB1\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[5].text
      value: "\u5176\u4E2D\u85CF\u6709\u4E00\u679A\u6954\u77F3\u3002\n\u5B83\u867D\u4E0D\u8000\u773C\uFF0C\u5374\u80FD\u7A33\u56FA\u5175\u5203\uFF0C\u53EF\u4EE5\u914D\u5408\u5176\u4ED6\u6750\u6599\u6765\u94F8\u9020\u5E26\u6709\u5F3A\u5927\u529B\u91CF\u7684\u6B66\u5668\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[6].text
      value: "\u82E5\u60A8\u5C1A\u672A\u51C6\u5907\u59A5\u5F53\uFF0C\n\u4FBF\u8BF7\u5148\u53D6\u8D70\u5B83\uFF0C\u518D\u7EE7\u7EED\u5411\u53F3\u4E0A\u65B9\u524D\u884C\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[7].text
      value: "\u6D1E\u7A74\u7684\u9876\u90E8\uFF0C\u4FBF\u662F\u5B88\u536B\u6240\u5728\u4E4B\u5730\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[8].text
      value: "\u8BF7\u8C28\u614E\uFF0C\u4F20\u706B\u8005\u5927\u4EBA\u3002\n\u7070\u5E55\u6DF1\u5904\u7684\u654C\u4EBA\uFF0C\u5F80\u5F80\u4E0D\u662F\u4E3A\u4E86\u6740\u622E\u800C\u5B58\u5728\u3002\n\u5B83\u4EEC\u53EA\u662F\u5FD8\u8BB0\u4E86\u81EA\u5DF1\u4E3A\u4F55\u5B88\u5728\u90A3\u91CC\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[9].text
      value: "\u82E5\u60A8\u80FD\u51FB\u8D25\u5B83\uFF0C\n\u6216\u8BB8\u80FD\u53D6\u56DE\u65E7\u4E16\u9057\u7559\u7684\u88C5\u5907\u3002\n\u4E5F\u6216\u8BB8\u2026\u2026\u80FD\u8BA9\u8FD9\u5EA7\u6D1E\u7A74\u5B89\u9759\u4E0B\u6765\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[10].text
      value: "\u6211\u4F1A\u5728\u6B64\u7B49\u5019\u3002\n\u82E5\u60A8\u7184\u706D\uFF0C\u4FBF\u5FAA\u7740\u8FD9\u7F15\u6B8B\u706B\u5F52\u6765\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}

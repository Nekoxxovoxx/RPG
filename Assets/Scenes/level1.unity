--- !u!1001 &1524500718
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 182537400}
    m_Modifications:
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}

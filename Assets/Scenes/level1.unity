    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: interactionPrompt
      value: "\u4E92\u52A8"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: playerSpeakerName
      value: "\u4F20\u706B\u8005"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.size
      value: 23
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[0].text
      value: "\u2026\u2026\u60A8\u9192\u4E86\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[1].text
      value: "\u8BF7\u8FD8\u5148\u6162\u4E9B\u884C\u52A8\uFF0C\u4F20\u706B\u8005\u5927\u4EBA\u3002\n\u60A8\u7684\u8840\u5C1A\u672A\u5B8C\u5168\u56DE\u6E29\uFF0C\u6B8B\u706B\u4E5F\u624D\u521A\u521A\u5F52\u4E8E\u80F8\u819B\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[2].text
      value: "\u6211\u5728\u6B64\u7B49\u5019\u5DF2\u4E45\u3002\n\u7B49\u5019\u8FD9\u7247\u7070\u5E55\u4E4B\u4E0B\uFF0C\u4ECD\u6709\u4EBA\u613F\u610F\u56DE\u5E94\u65E7\u706B\u7684\u547C\u5524\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[3].text
      value: "\u6211\u662F\u8C01\uFF1F"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[4].text
      value: "\u8BF7\u5BB9\u6211\u5411\u60A8\u81F4\u793C\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[5].text
      value: "\u60A8\u662F\u4F20\u706B\u8005\u3002\n\u4EA6\u662F\u4ECE\u7070\u4E2D\u5F52\u6765\u7684\u70EC\u88D4\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[6].text
      value: "\u8FD9\u91CC\u662F\u54EA\u91CC\uFF1F"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[7].text
      value: "\u8FD9\u91CC\u66FE\u662F\u65E7\u706B\u71C3\u8D77\u4E4B\u5730\u2014\u2014\u6D1B\u708E\u5FB7\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[8].text
      value: "\u4F46\u7070\u5E55\u4E0E\u5F02\u754C\u795E\u683C\u7684\u964D\u4E34\u6539\u53D8\u4E86\u8FD9\u7247\u5730\u754C\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[9].text
      value: "\u4E3A\u4E86\u62B5\u6297\u5F02\u754C\u795E\u683C\uFF0C\u5EF6\u7F13\u7070\u5E55\u541E\u566C\u7684\u901F\u5EA6\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[10].text
      value: "\u6D1B\u708E\u5FB7\u8BF8\u738B\u820D\u5F03\u4E86\u8089\u8EAB\uFF0C\u8BBE\u4E0B\u65E7\u706B\u5F8B\uFF0C\u5316\u4E3A\u70EC\u738B\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[11].text
      value: "\u53D7\u65E7\u706B\u5F8B\u7684\u5F71\u54CD\uFF0C\u4F20\u706B\u8005\u4EEC\u88AB\u6B7B\u4EA1\u62D2\u4E4B\u95E8\u5916\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[12].text
      value: "\u4ED6\u4EEC\u5C06\u7EE7\u7EED\u5728\u8FD9\u7247\u5730\u754C\u4E0A\u6C38\u65E0\u6B62\u5883\u5730\u6218\u6597\u3001\u6B7B\u4EA1\uFF0C\u65E0\u6570\u6B21\u4ECE\u4F59\u70EC\u4E2D\u82CF\u9192\uFF0C\u76F4\u81F3\u7070\u7EAA\u7ED3\u675F\uFF0C\u7184\u4E16\u5230\u6765\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[13].text
      value: "\u82E5\u662F\u80FD\u5C06\u5F02\u754C\u795E\u683C\u5C60\u622E\u6B86\u5C3D\uFF0C\u9A71\u6563\u7070\u5E55\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[14].text
      value: "\u90A3\u4FBF\u80FD\u91CD\u8FD4\u738B\u706B\u7EAA\uFF0C\u62EF\u6551\u4E16\u754C\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[15].text
      value: "\u6211\u8FD8\u662F\u4E0D\u592A\u660E\u767D\uFF0C\u6211\u4EC0\u4E48\u90FD\u8BB0\u4E0D\u6E05\u4E86\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[16].text
      value: "\u6CA1\u5173\u7CFB\uFF0C\u4F20\u706B\u8005\u5927\u4EBA\u3002\u5F02\u754C\u795E\u683C\u53D7\u65E7\u706B\u5F8B\u7684\u5F71\u54CD\u8FD8\u5728\u6C89\u7761\u3002\u7184\u4E16\u4E0D\u4F1A\u90A3\u4E48\u5FEB\u5230\u6765\uFF0C\u6211\u4EEC\u8FD8\u6709\u5F88\u591A\u65F6\u95F4\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[17].text
      value: "\u5C3D\u7BA1\u60A8\u7684\u8BB0\u5FC6\u5728\u5F52\u706B\u4E2D\u635F\u5931\u4E86\u4E0D\u5C11\uFF0C\u4F46\u6218\u6597\u672C\u80FD\u4F9D\u7136\u523B\u5728\u60A8\u7684\u9AA8\u5B50\u91CC\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[18].text
      value: "\u4F60\u8FD8\u6CA1\u6709\u544A\u8BC9\u6211\u4F60\u662F\u4EC0\u4E48\u4EBA\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[19].text
      value: "\u6211\u662F\u60A8\u7684\u4F8D\u706B\u5DEB\u5973\uFF0C\u6211\u7684\u4F7F\u547D\u5C31\u662F\u4E0E\u60A8\u4E00\u8D77\u62EF\u6551\u6B64\u4E16\uFF0C\u76F4\u81F3\u71C3\u5C3D\u6B64\u8EAB\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[20].text
      value: "\u6211\u4F1A\u5728\u65C5\u9014\u4E2D\u4F34\u60A8\u5DE6\u53F3\uFF0C\u4E3A\u60A8\u63D0\u4F9B\u5E2E\u52A9\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[21].text
      value: "\u524D\u65B9\u6D1E\u53E3\u6709\u6211\u4E3A\u60A8\u51C6\u5907\u7684\u88C5\u5907\uFF0C\u7A7F\u4E0A\u5B83\u4EEC\u53BB\u6218\u6597\u5427\uFF0C\u53BB\u6539\u53D8\u65E9\u5DF2\u6CE8\u5B9A\u7684\u547D\u8FD0\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 1689230886234442912, guid: db26db5a6bacdd94c8c313a1a322fb3f, type: 3}
      propertyPath: conversationLines.Array.data[22].text
      value: "\u613F\u4F59\u70EC\u4E3A\u60A8\u7167\u4EAE\u524D\u8DEF......"

      propertyPath: conversationLines.Array.data[26].text
      value: "\u53EA\u8981\u60A8\u4ECD\u613F\u5F52\u6765\uFF0C\n\u6211\u4FBF\u4F1A\u5728\u6B64\u7B49\u5019\u60A8\u3002"
